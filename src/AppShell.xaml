<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MoodBoost.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MoodBoost.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="MoodBoost">

    <TabBar>
        <ShellContent Title="Home"
                      Icon="home"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />

        <ShellContent Title="Themes"
                      Icon="palette"
                      ContentTemplate="{DataTemplate local:ThemesPage}"
                      Route="ThemesPage" />
    </TabBar>

</Shell>
